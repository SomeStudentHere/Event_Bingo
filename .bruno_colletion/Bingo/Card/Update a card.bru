meta {
  name: Update a card
  type: http
  seq: 5
}

put {
  url: http://localhost:8080/cards/2
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "test",
    "rows": 2,
    "cols": 2,
    "line_prize": 50,
    "bingo_prize": 500,
    "price": 10,
    "events": [52,3,4,5],
    "approved": "true"
    
  }
}

body:form-urlencoded {
  full_name: test test test
  email: a@mail.com
  password: 123
}
